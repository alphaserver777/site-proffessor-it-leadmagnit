services:
  site:
    image: {{ site_container_image }}
    container_name: professorit-site
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      # Mount the complete release tree at the same absolute path. Mounting
      # ./current directly would resolve the symlink only at container start
      # and make later atomic release switches invisible to Nginx.
      - {{ project_root }}:{{ project_root }}:ro
      - ./config:/etc/nginx/professorit:ro
      - ./config/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./acme:/var/www/acme:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    read_only: true
    tmpfs:
      - /var/cache/nginx
      - /var/run
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
      - NET_BIND_SERVICE
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - runtime

networks:
  runtime:
    external: true
    name: {{ runtime_network }}
