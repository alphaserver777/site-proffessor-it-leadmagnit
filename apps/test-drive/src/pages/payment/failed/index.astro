---
import Base from '@professorit/funnel-shared/Base.astro';
---
<Base title="Оплата не завершена — Профессор IT" description="Повтор оплаты тест-драйва IT-профессии">
  <main class="payment-result shell">
    <section class="payment-result-card">
      <span class="success-mark payment-failed">!</span>
      <p class="kicker">PRODAMUS / ОПЛАТА</p>
      <h1>Оплата не завершена</h1>
      <p data-fail-copy>Деньги не списаны. Можно безопасно вернуться к оплате или задать вопрос перед продолжением.</p>
      <button class="button primary large" type="button" data-retry-payment>Повторить оплату</button>
      <div class="form-error" data-retry-error></div>
      <div class="payment-result-links">
        <strong>Возник вопрос перед оплатой?</strong>
        <p>Напишите мне в удобном мессенджере — помогу разобраться и продолжить оформление тест-драйва.</p>
        <div class="payment-channel-buttons">
          <a class="button primary large" href="https://t.me/proffessor_it" target="_blank" rel="noreferrer">Написать в Telegram</a>
          <a class="button large payment-max" href="https://max.ru/u/f9LHodD0cOKSwTkPJdylbGaluZM4miWZqbpMcBD7uTVI8UGfJLvPabOTi08" target="_blank" rel="noreferrer">Написать в MAX</a>
        </div>
      </div>
    </section>
  </main>
  <script>
    const token=new URLSearchParams(location.search).get('enrollment');const button=document.querySelector<HTMLButtonElement>('[data-retry-payment]');const error=document.querySelector<HTMLElement>('[data-retry-error]');button?.addEventListener('click',async()=>{if(!token){if(error)error.textContent='Не найден номер заявки. Вернитесь на главную и заполните форму.';return;}button.disabled=true;try{const response=await fetch(`/api/public/test-drive/${encodeURIComponent(token)}/payment-link`,{method:'POST'});const result=await response.json();if(!response.ok||!result.payment_url)throw new Error(result.detail?.message||'Не удалось открыть оплату');location.assign(result.payment_url);}catch(reason){if(error)error.textContent=reason instanceof Error?reason.message:'Ошибка открытия оплаты';button.disabled=false;}});
  </script>
</Base>
