---
import { personas } from "../data/site";
---

<dialog class="brief-dialog" id="brief-dialog" aria-labelledby="brief-title">
  <button class="dialog-close" type="button" data-close aria-label="Закрыть"
    >×</button
  >
  <div class="brief-progress" aria-hidden="true">
    <span data-progress></span>
  </div>
  <div class="brief-head">
    <span class="kicker">ТЕСТ-ДРАЙВ · 1 000 ₽</span>
    <h2 id="brief-title">Выберите профессию для тест-драйва</h2>
    <p>
      Три дня практики, мини-квест и личный 30-минутный разбор вашего решения
    </p>
  </div>
  <form id="brief-form">
    <section class="brief-step active" data-step="1">
      <span class="step-label">01 / ВЫБОР КЛАССА</span>
      <h3>Какое направление хотите попробовать?</h3>
      <div class="brief-personas">
        {
          personas.map((item) => (
            <label class="brief-persona" style={`--accent:${item.color}`}>
              <>
                <input type="radio" name="persona" value={item.id} required />
                <span>{item.eyebrow}</span>
                <strong>{item.name}</strong>
              </>
            </label>
          ))
        }
      </div>
      <label
        >Текущий уровень<select name="student_level" required
          ><option value="beginner">Начинаю с нуля</option><option value="basic"
            >Есть отдельные знания</option
          ><option value="junior">Junior / студент с практикой</option><option
            value="middle">Middle-специалист</option
          ><option value="senior">Senior / экспертная задача</option></select
        ></label
      >
    </section>
    <section class="brief-step" data-step="2">
      <span class="step-label">02 / ВАША ЗАДАЧА</span>
      <h3>Что хотите проверить на тест-драйве?</h3>
      <label
        >Главная цель<textarea
          name="goal"
          minlength="5"
          maxlength="500"
          required
          placeholder="Например: понять, подходит ли мне DevOps и его реальные задачи"
        ></textarea></label
      >
      <label
        >Что сейчас не получается<textarea
          name="current_problem"
          minlength="3"
          maxlength="700"
          required
          placeholder="Какие темы, задачи или ошибки останавливают вас?"
        ></textarea></label
      >
      <div class="form-grid">
        <label
          >Желаемый срок<select name="desired_timeline" required
            ><option value="1 месяц">До месяца</option><option
              value="2–3 месяца">2–3 месяца</option
            ><option value="3–6 месяцев">3–6 месяцев</option><option
              value="Без жёсткого срока">Без жёсткого срока</option
            ></select
          ></label
        ><label
          >Практика в неделю<select name="weekly_hours" required
            ><option value="2–3 часа">2–3 часа</option><option value="4–6 часов"
              >4–6 часов</option
            ><option value="7–10 часов">7–10 часов</option><option
              value="10+ часов">10+ часов</option
            ></select
          ></label
        >
      </div>
    </section>
    <section class="brief-step" data-step="3">
      <span class="step-label">03 / КОНТАКТ</span>
      <h3>Куда отправить доступ после оплаты?</h3>
      <label
        >Имя и фамилия<input
          name="full_name"
          minlength="2"
          maxlength="100"
          autocomplete="name"
          required
          placeholder="Иван Петров"
        /></label
      >
      <div class="form-grid">
        <label
          >Телефон<input
            name="telephone"
            minlength="10"
            maxlength="24"
            inputmode="tel"
            autocomplete="tel"
            required
            placeholder="89881414232"
          /></label
        ><label
          >Telegram <small>необязательно</small><input
            name="telegram_username"
            maxlength="100"
            placeholder="@username"
          /></label
        >
      </div>
      <input
        class="hp"
        tabindex="-1"
        autocomplete="off"
        name="honeypot"
        aria-hidden="true"
      />
      <label class="consent"
        ><input type="checkbox" name="consent" required />
        <span
          >Я согласен на обработку персональных данных и принимаю <a
            href="/privacy/"
            target="_blank">политику конфиденциальности</a
          >.</span
        ></label
      >
      <div class="order-summary">
        <span>Тест-драйв профессии</span><strong>1 000 ₽</strong><small
          >Задание + инструменты + проверка + личный разбор</small
        >
      </div>
    </section>
    <div class="form-error" data-error role="alert"></div>
    <div class="brief-actions">
      <button class="button ghost" type="button" data-prev hidden>Назад</button
      ><button class="button primary" type="button" data-next>Продолжить</button
      ><button class="button primary" type="submit" data-submit hidden
        >Оформить тест-драйв</button
      >
    </div>
  </form>
  <section class="brief-success" data-success hidden>
    <span class="success-mark">✓</span><h3>Заявка создана</h3><p>
      Вы выбрали профессию. Остался один шаг — безопасно оплатить
      <strong>тест-драйв за 1 000 ₽</strong>. После подтверждения оплаты заявка
      автоматически появится у меня в панели.
    </p>
    <button class="button primary large payment-button" type="button" data-payment-button>
      Перейти к оплате <b>1 000 ₽</b>
    </button>
    <div class="form-error payment-error" data-payment-error role="alert"></div>
    <small class="payment-security">Платёж проводится на защищённой странице Prodamus</small>
    <p class="contact-fallback">Если перед оплатой остался вопрос — напишите мне удобным способом</p>
    <div class="contact-choice" aria-label="Выберите удобный мессенджер">
      <a class="contact-option telegram" data-contact-channel="telegram" href="https://t.me/proffessor_it" target="_blank" rel="noreferrer">
        <span>Telegram</span><strong>Написать в Telegram</strong><small>Быстрый ответ и все материалы в одном чате</small>
      </a>
      <a class="contact-option max" data-contact-channel="max" href="https://max.ru/u/f9LHodD0cOKSwTkPJdylbGaluZM4miWZqbpMcBD7uTVI8UGfJLvPabOTi08" target="_blank" rel="noreferrer">
        <span>MAX</span><strong>Написать в MAX</strong><small>Если вы предпочитаете российский мессенджер</small>
      </a>
    </div>
    <small class="contact-note">Telegram и MAX остаются каналами связи, но подтверждение участия происходит автоматически после оплаты</small>
  </section>
</dialog>
