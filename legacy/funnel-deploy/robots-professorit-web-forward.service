[Unit]
Description=Forward Professor IT website to VM static-site container
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:8083,bind=172.17.0.1,reuseaddr,fork TCP:192.168.122.10:18080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
