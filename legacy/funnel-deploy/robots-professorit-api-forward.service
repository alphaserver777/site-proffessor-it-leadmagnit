[Unit]
Description=Forward Professor IT public API to the application VM
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:8084,bind=172.17.0.1,reuseaddr,fork TCP:192.168.122.10:18000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
